<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:StreamripperGui.Desktop.Localization"
        xmlns:vm="using:StreamripperGui.Desktop.ViewModels"
        x:Class="StreamripperGui.Desktop.Views.SettingsWindow" x:DataType="vm:MainWindowViewModel"
        Title="{loc:T SettingsTitle}" Width="700" Height="540" CanResize="False" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <Button DockPanel.Dock="Bottom" Content="{loc:T CloseSettings}" IsDefault="True" Classes="accent"
            HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseClick" />
    <ScrollViewer>
      <StackPanel Spacing="12">
        <TextBlock Text="{loc:T RecordingDirectory}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding RecordingRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="PathLostFocus" />
          <Button Grid.Column="1" Click="ChooseRecordingFolderClick" ToolTip.Tip="{loc:T ChooseFolder}">
            <PathIcon Data="M2,4 L8,4 10,6 22,6 22,20 2,20 Z" Width="18" Height="18" />
          </Button>
        </Grid>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
          <TextBlock Text="{loc:T ImportSection}" />
          <TextBlock Grid.Column="1" Text="{loc:T FilterImportSection}" />
          <Button Grid.Row="1" Content="{loc:T ImportOPML}" Click="ImportClick" IsEnabled="{Binding CanImportStations}" HorizontalAlignment="Left" />
          <Button Grid.Row="1" Grid.Column="1" Content="{loc:T ChooseRulesFolder}" Click="ImportRulesClick" HorizontalAlignment="Left" />
        </Grid>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
          <TextBlock Text="{loc:T Language}" />
          <TextBlock Grid.Column="1" Text="{loc:T Theme}" />
          <ComboBox Grid.Row="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OptionChoice"><TextBlock Text="{loc:TranslateBinding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OptionChoice"><TextBlock Text="{loc:TranslateBinding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <TextBlock Text="{loc:T StreamripperExecutable}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="PathLostFocus" />
          <Button Grid.Column="1" Click="ChooseExecutableClick" ToolTip.Tip="{loc:T ChooseFile}">
            <PathIcon Data="M4,2 L14,2 20,8 20,22 4,22 Z M14,2 L14,8 20,8" Width="18" Height="18" />
          </Button>
        </Grid>
        <TextBlock Text="{loc:T ConfigurationDirectory}" />
        <TextBox Text="{Binding ConfigurationDirectory, Mode=OneWay}" IsReadOnly="True"
                 Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        <TextBlock Text="{loc:TranslateBinding SettingsError}" IsVisible="{Binding HasSettingsError}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
