<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StreamripperGui.Desktop.Localization" xmlns:vm="using:StreamripperGui.Desktop.ViewModels"
        x:Class="StreamripperGui.Desktop.Views.RulesImportWindow" x:DataType="vm:RulesImportViewModel"
        Title="{loc:T ImportRules}" Width="640" Height="440" CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
    <TextBlock Text="{loc:T RulesImportHelp}" TextWrapping="Wrap" />
    <Grid Grid.Row="1">
      <TextBlock Text="{loc:T RulesImportEmpty}" IsVisible="{Binding !HasEntries}" TextWrapping="Wrap" />
      <ListBox ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RulesImportEntry">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding File}" FontSize="12" Opacity="0.7" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
      </ListBox>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{loc:T Cancel}" IsCancel="True" Click="CancelClick" />
      <Button Content="{loc:T ImportRules}" Command="{Binding ImportCommand}" IsDefault="True" Classes="accent" />
    </StackPanel>
  </Grid>
</Window>
