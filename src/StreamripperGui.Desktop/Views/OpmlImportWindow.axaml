<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:StreamripperGui.Desktop.Localization"
        xmlns:vm="using:StreamripperGui.Desktop.ViewModels"
        xmlns:models="using:StreamripperGui.Core.Models"
        x:Class="StreamripperGui.Desktop.Views.OpmlImportWindow"
        x:DataType="vm:OpmlImportViewModel"
        Title="{loc:T ImportStationsFromOPML}" Width="820" Height="650"
        MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </Grid.Styles>
    <CheckBox Content="{loc:T RemoveOldStationsReplace}" IsChecked="{Binding ReplaceOldStations, Mode=TwoWay}" IsEnabled="{Binding !IsLoading}" />
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{loc:TranslateBinding Summary}" TextWrapping="Wrap" />
      <TextBlock Text="{loc:TranslateBinding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <TextBlock Text="{loc:T OpmlMatchingHint}"
                 TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
    </StackPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="{loc:T StationsToImport}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="{loc:T SelectAll}" Command="{Binding SelectAllCommand}" IsEnabled="{Binding !IsLoading}" />
            <Button Content="{loc:T SelectNone}" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding !IsLoading}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OpmlSelection">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" />
                    <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="{loc:T PlannedChanges}">
        <ListBox ItemsSource="{Binding Preview}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:OpmlImportChange">
              <Grid ColumnDefinitions="75,*" ColumnSpacing="8" Margin="4">
                <TextBlock Text="{loc:TranslateBinding Action}" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Url}" IsVisible="{Binding HasUrl}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PreviousUrl}" IsVisible="{Binding HasPreviousUrl}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{loc:TranslateBinding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{loc:T Cancel}" IsCancel="True" Click="CancelClick" />
      <Button Content="{loc:T Import}" Command="{Binding ApplyCommand}" IsDefault="True"
              Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentButtonForeground}" />
    </StackPanel>
  </Grid>
</Window>
